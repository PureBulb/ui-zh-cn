{
  "command": "node",
  "args": ["--max-old-space-size=32", "--optimize-for-size", "main.mjs"],
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=32 --optimize-for-size"
  },
  "restart_policy": "always",
